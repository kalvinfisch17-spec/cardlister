# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/cardlister

# OpenAI API key for card image analysis
# Get one at https://platform.openai.com/api-keys
AI_INTEGRATIONS_OPENAI_API_KEY=sk-...
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# eBay Developer credentials
# Get these at https://developer.ebay.com → My Account → Application Keys (Production)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Redirect URI registered in your eBay app's OAuth settings
EBAY_REDIRECT_URI=http://localhost:3000/api/ebay/callback
# Set to "true" to use eBay sandbox for testing
EBAY_SANDBOX=false

# Session secret — any random string
SESSION_SECRET=change-me-to-a-random-string
