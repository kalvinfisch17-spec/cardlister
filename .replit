modules = ["nodejs-20", "web", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
EBAY_LOCATION = "Birnamwood WI 54414"
EBAY_REDIRECT_URI = "https://68b287ba-537f-4561-acff-eef62674417a-00-12cgv9va6g7ou.riker.replit.dev/api/ebay/callback"
EBAY_SANDBOX = "false"
